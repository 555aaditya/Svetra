{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AneeMCjstajFn9zA5oS2xT","type":"tool_result","content":"-- Private notes: each person sees and changes only their own notes.\n\ncreate table public.note (\n  id    uuid primary key default gen_random_uuid(),\n  owner uuid not null default auth.uid() references auth.users (id) on delete cascade,\n  body  text not null\n);\n\ncreate index note_owner_idx on public.note (owner);\n\nalter table public.note enable row level security;\nalter table public.note force row level security;\n\n-- No access for anonymous visitors; signed-in users get table privileges,\n-- narrowed to their own rows by the policies below.\nrevoke all on public.note from anon, public;\ngrant select, insert, update, delete on public.note to authenticated;\n\ncreate policy note_select_own on public.note\n  for select to authenticated\n  using (owner = (select auth.uid()));\n\ncreate policy note_insert_own on public.note\n  for insert to authenticated\n  with check (owner = (select auth.uid()));\n\ncreate policy note_update_own on public.note\n  for update to authenticated\n  using (owner = (select auth.uid()))\n  with check (owner = (select auth.uid()));\n\ncreate policy note_delete_own on public.note\n  for delete to authenticated\n  using (owner = (select auth.uid()));\n\n-- Ownership is fixed at creation: block reassigning a note to someone else.\ncreate function public.note_lock_owner() returns trigger\nlanguage plpgsql\nset search_path = ''\nas $$\nbegin\n  if new.owner is distinct from old.owner then\n    raise exception 'note owner cannot be changed';\n  end if;\n  return new;\nend;\n$$;\n\ncreate trigger note_lock_owner\n  before update on public.note\n  for each row execute function public.note_lock_owner();","is_error":false}]},"parent_tool_use_id":null,"session_id":"f086e4b9-66b1-4eca-a6c7-6269fb2ffa06","uuid":"b4eba5fb-201d-4962-8c85-64b3aac28210","timestamp":"2026-11-17T17:40:36.830Z","tool_use_result":{"stdout":"-- Private notes: each person sees and changes only their own notes.\n\ncreate table public.note (\n  id    uuid primary key default gen_random_uuid(),\n  owner uuid not null default auth.uid() references auth.users (id) on delete cascade,\n  body  text not null\n);\n\ncreate index note_owner_idx on public.note (owner);\n\nalter table public.note enable row level security;\nalter table public.note force row level security;\n\n-- No access for anonymous visitors; signed-in users get table privileges,\n-- narrowed to their own rows by the policies below.\nrevoke all on public.note from anon, public;\ngrant select, insert, update, delete on public.note to authenticated;\n\ncreate policy note_select_own on public.note\n  for select to authenticated\n  using (owner = (select auth.uid()));\n\ncreate policy note_insert_own on public.note\n  for insert to authenticated\n  with check (owner = (select auth.uid()));\n\ncreate policy note_update_own on public.note\n  for update to authenticated\n  using (owner = (select auth.uid()))\n  with check (owner = (select auth.uid()));\n\ncreate policy note_delete_own on public.note\n  for delete to authenticated\n  using (owner = (select auth.uid()));\n\n-- Ownership is fixed at creation: block reassigning a note to someone else.\ncreate function public.note_lock_owner() returns trigger\nlanguage plpgsql\nset search_path = ''\nas $$\nbegin\n  if new.owner is distinct from old.owner then\n    raise exception 'note owner cannot be changed';\n  end if;\n  return new;\nend;\n$$;\n\ncreate trigger note_lock_owner\n  before update on public.note\n  for each row execute function public.note_lock_owner();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AneeMCjstajFn9zA5oS2xT","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
